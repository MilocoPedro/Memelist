rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email != null);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidList(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'ownerEmail', 'sharedWith', 'createdAt', 'updatedAt', 'isArchived'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.sharedWith is list
        && data.isArchived is bool;
    }

    function isValidItem(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'quantity', 'unit', 'price', 'checked', 'createdAt', 'updatedAt', 'addedBy'])
        && data.keys().hasOnly(['id', 'name', 'category', 'quantity', 'unit', 'price', 'checked', 'createdAt', 'updatedAt', 'addedBy', 'addedByName', 'imageUrl'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.category is string && data.category.size() <= 100
        && data.quantity is number && data.quantity >= 0
        && data.unit is string && data.unit.size() <= 30
        && (data.price == null || data.price is number)
        && data.checked is bool
        && data.addedBy is string;
    }

    function hasWriteAccessList(listDoc) {
      return isSignedIn() && listDoc != null && (
        listDoc.ownerId == request.auth.uid ||
        request.auth.token.email in listDoc.sharedWith
      );
    }

    function hasReadAccessListId(listId) {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/lists/$(listId)) ||
        (get(/databases/$(database)/documents/lists/$(listId)).data.ownerId == request.auth.uid ||
         request.auth.token.email in get(/databases/$(database)/documents/lists/$(listId)).data.sharedWith)
      );
    }

    function hasWriteAccessListId(listId) {
      return isSignedIn() && exists(/databases/$(database)/documents/lists/$(listId)) && hasWriteAccessList(get(/databases/$(database)/documents/lists/$(listId)).data);
    }

    match /lists/{listId} {
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.token.email in resource.data.sharedWith
      );

      // IMPORTANTE (documentado oficialmente por Firebase): en una consulta 'list',
      // el filtro where() del cliente debe coincidir exactamente con la condición de
      // la regla. Por eso van SEPARADAS: la query de "mis listas" filtra por ownerId,
      // la query de "listas compartidas" filtra por sharedWith. Un único OR mezclando
      // ambos campos hace que Firestore rechace la consulta entera con
      // "Property ownerId is undefined", aunque el documento real sí lo tenga.
      // NO fusionar estas dos líneas en una sola con "||".
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && request.auth.token.email in resource.data.sharedWith;

      allow create: if isEmailVerified()
        && isValidId(listId)
        && isValidList(incoming());

      allow update: if isEmailVerified()
        && hasWriteAccessList(existing())
        && isValidList(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['name', 'sharedWith', 'isArchived', 'updatedAt'])) ||
          (request.auth.token.email in existing().sharedWith && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isArchived', 'updatedAt']))
        );

      allow delete: if isSignedIn()
        && existing() != null && 'ownerId' in existing() && existing().ownerId == request.auth.uid;

      match /items/{itemId} {
        allow get: if isSignedIn() && hasReadAccessListId(listId);
        allow list: if isSignedIn() && hasReadAccessListId(listId);

        allow create: if isEmailVerified()
          && isValidId(itemId)
          && hasWriteAccessListId(listId)
          && isValidItem(incoming())
          && incoming().addedBy == request.auth.uid;

        allow update: if isEmailVerified()
          && hasWriteAccessListId(listId)
          && isValidItem(incoming())
          && 'addedBy' in existing() && incoming().addedBy == existing().addedBy
          && 'createdAt' in existing() && incoming().createdAt == existing().createdAt
          && (
            incoming().diff(existing()).affectedKeys().hasAny(['checked', 'quantity', 'unit', 'price', 'category', 'name', 'updatedAt'])
          );

        allow delete: if isEmailVerified()
          && hasWriteAccessListId(listId);
      }
    }

    match /mercadona_catalog/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
