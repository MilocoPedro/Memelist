rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.email != null);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validates list creation and properties
    function isValidList(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'ownerEmail', 'sharedWith', 'createdAt', 'updatedAt', 'isArchived'])
        && data.keys().size() == 8
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.sharedWith is list
        && data.isArchived is bool;
    }

    // Validates shopping item properties
    // Required fields: 10 core fields. Optional: addedByName, imageUrl
    function isValidItem(data) {
      let requiredKeys = ['id', 'name', 'category', 'quantity', 'unit', 'price', 'checked', 'createdAt', 'updatedAt', 'addedBy'];
      let optionalKeys = ['addedByName', 'imageUrl'];
      let allAllowedKeys = requiredKeys.concat(optionalKeys);
      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(allAllowedKeys)
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.category is string && data.category.size() <= 100
        && data.quantity is number && data.quantity >= 0
        && data.unit is string && data.unit.size() <= 30
        && (data.price == null || data.price is number)
        && data.checked is bool
        && data.addedBy is string
        && (!('addedByName' in data) || data.addedByName is string)
        && (!('imageUrl' in data) || data.imageUrl is string);
    }

    // Checking access to a shopping list
    function hasReadAccessList(listDoc) {
      return isSignedIn() && listDoc != null && (
        listDoc.ownerId == request.auth.uid ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 'sharedWith' in listDoc && listDoc.sharedWith is list && (
          request.auth.token.email.lower() in listDoc.sharedWith ||
          request.auth.token.email in listDoc.sharedWith
        ))
      );
    }

    function hasWriteAccessList(listDoc) {
      return isSignedIn() && listDoc != null && (
        listDoc.ownerId == request.auth.uid ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 'sharedWith' in listDoc && listDoc.sharedWith is list && (
          request.auth.token.email.lower() in listDoc.sharedWith ||
          request.auth.token.email in listDoc.sharedWith
        ))
      );
    }

    function hasReadAccessListId(listId) {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/lists/$(listId)) ||
        hasReadAccessList(get(/databases/$(database)/documents/lists/$(listId)).data)
      );
    }

    function hasWriteAccessListId(listId) {
      return isSignedIn() && exists(/databases/$(database)/documents/lists/$(listId)) && hasWriteAccessList(get(/databases/$(database)/documents/lists/$(listId)).data);
    }

    // Shopping list Match Block
    match /lists/{listId} {
      allow get: if hasReadAccessList(existing());
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && 'sharedWith' in resource.data && resource.data.sharedWith is list && (
          request.auth.token.email.lower() in resource.data.sharedWith ||
          request.auth.token.email in resource.data.sharedWith
        ))
      );

      allow create: if isEmailVerified()
        && isValidId(listId)
        && isValidList(incoming());

      allow update: if isEmailVerified()
        && hasWriteAccessList(existing())
        && isValidList(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Owner full edit (or edit share list)
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['name', 'sharedWith', 'isArchived', 'updatedAt'])) ||
          // Action 2: Shared member edits only status or name
          (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && existing().sharedWith is list && request.auth.token.email in existing().sharedWith && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isArchived', 'updatedAt']))
        );

      allow delete: if isSignedIn()
        && existing() != null && 'ownerId' in existing() && existing().ownerId == request.auth.uid;

      // Shopping items Subcollection Match Block
      match /items/{itemId} {
        allow get: if isSignedIn() && hasReadAccessListId(listId);
        allow list: if isSignedIn() && hasReadAccessListId(listId);

        allow create: if isEmailVerified()
          && isValidId(itemId)
          && hasWriteAccessListId(listId)
          && isValidItem(incoming())
          && incoming().addedBy == request.auth.uid;

        allow update: if isEmailVerified()
          && hasWriteAccessListId(listId)
          && isValidItem(incoming())
          && 'addedBy' in existing() && incoming().addedBy == existing().addedBy
          && 'createdAt' in existing() && incoming().createdAt == existing().createdAt
          && (
            // Anyone with access can toggle bought, quantities, price, categories
            incoming().diff(existing()).affectedKeys().hasAny(['checked', 'quantity', 'unit', 'price', 'category', 'name', 'updatedAt'])
          );

        allow delete: if isEmailVerified()
          && hasWriteAccessListId(listId);
      }
    }
  }
}
